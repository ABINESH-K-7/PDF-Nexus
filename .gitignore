# Secrets and local environment overrides
.env
.env.*
!.env.example

# JavaScript dependencies, builds, logs, and caches
node_modules/
dist/
dist-ssr/
build/
.vite/
coverage/
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Python environments, bytecode, and tooling caches
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

